<body>

<div class="card">
    <h2>🛍️ Калькулятор заказа</h2>
    
    <div class="form-group">
        <label>Категория товара:</label>
        <select id="category" onchange="calculate()">
            <option value="200">Футболка / Кепка (+200 грн)</option>
            <option value="350">Худи / Свитшот (+350 грн)</option>
            <option value="500">Кроссовки / Куртка (+500 грн)</option>
        </select>
    </div>

    <div class="form-group">
        <label>Цена товара (€ EUR):</label>
        <input type="number" id="price" value="50" oninput="calculate()">
    </div>

    <div class="result" id="total-result">
        Итого: 0 UAH
    </div>

    <button onclick="sendData()">Отправить расчет в бот</button>
</div>

<script>
    const tg = window.Telegram.WebApp;
    tg.expand(); // Разворачивает окно Mini App на весь экран

    const EUR_RATE = 45.0;
    const MARGIN = 400;

    function calculate() {
        const delivery = parseFloat(document.getElementById('category').value);
        const priceEur = parseFloat(document.getElementById('price').value) || 0;

        const totalUah = (priceEur * EUR_RATE) + delivery + MARGIN;
        document.getElementById('total-result').innerText = `Итого: ${Math.round(totalUah)} UAH`;
        return { priceEur, delivery, totalUah: Math.round(totalUah) };
    }

    function sendData() {
        const data = calculate();
        // Передаем данные обратно в aiogram через Telegram WebApp SDK
        tg.sendData(JSON.stringify(data));
    }

    // Первоначальный расчет при загрузке страницы
    calculate();
</script>
