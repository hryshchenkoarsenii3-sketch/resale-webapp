<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Новое Напоминание</title>
    <!-- Подключаем Telegram WebApp SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--tg-theme-bg-color, #ffffff);
            color: var(--tg-theme-text-color, #000000);
            padding: 20px;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        h2 { margin: 0 0 10px 0; font-size: 20px; text-align: center; }
        label { font-size: 14px; font-weight: 600; color: var(--tg-theme-hint-color, #888); }
        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 16px;
            background-color: var(--tg-theme-secondary-bg-color, #f0f0f0);
            color: var(--tg-theme-text-color, #000);
        }
        button {
            width: 100%;
            padding: 14px;
            background-color: var(--tg-theme-button-color, #2481cc);
            color: var(--tg-theme-button-text-color, #ffffff);
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
        }
    </style>
</head>
<body>

    <h2>⏰ Поставить напоминание</h2>

    <div>
        <label for="task">О чём напомнить?</label>
        <input type="text" id="task" placeholder="Например: Тренировка по футболу">
    </div>

    <div>
        <label for="time">Во сколько? (Время сегодня)</label>
        <input type="time" id="time">
    </div>

    <button onclick="sendReminder()">Сохранить напоминание</button>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand(); // Разворачиваем на весь экран

        // Автоматически подставляем текущее время + 5 минут
        const now = new Date();
        now.setMinutes(now.getMinutes() + 5);
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        document.getElementById('time').value = `${hours}:${minutes}`;

        function sendReminder() {
            const task = document.getElementById('task').value.trim();
            const time = document.getElementById('time').value;

            if (!task) {
                alert("Пожалуйста, введи текст задачи!");
                return;
            }

            // Формируем данные в JSON и отправляем в бот
            const data = { task: task, time: time };
            tg.sendData(JSON.stringify(data));
        }
    </script>
</body>
</html>
